# CruzBot Instance #2 — isolated Kraken paper checkout
# Copy this file to .env in a second working directory (cruzbot_instance_2).
# Do not share SQLite / paper book / optimizer files with Instance #1.
#
# Strategy stack is unchanged from Instance #1:
#   5m low-volume retest / volume sweet spot, EMA 1h/4h confluence,
#   L2 imbalance, ADX/chop, ATR sizing ($50 trade / $200 book),
#   Binance/Bybit lead-lag, POST_ONLY maker defaults.
#
# Live remains gated: keep PAPER_TRADING_MODE=true. Runtime live still
# requires Telegram /mode live + /confirm_live (or explicit --live).

# --- Mode (paper by default) ---
PAPER_TRADING_MODE=true
DRY_RUN=false
BROKER=kraken
ACCOUNT_EQUITY=200
SYMBOLS=BTC-USD,ETH-USD,SOL-USD,XRP-USD,LINK-USD,AVAX-USD,SUI-USD,ADA-USD

# --- Kraken spot keys (never commit real secrets) ---
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_BASE_URL=https://api.kraken.com
KRAKEN_WS_URL=wss://ws.kraken.com

# Instance #1 Coinbase vars are unused here; keep empty so this process
# cannot accidentally construct a Coinbase client.
COINBASE_API_KEY=
COINBASE_API_SECRET=

# --- Instance #2 isolated persistence (distinct from Instance #1) ---
SQLITE_PATH=data/trading_bot_2.db
PAPER_BOOK_PATH=data/paper_book_2.json
ACTIVE_PARAMS_PATH=data/active_params_2.json
SQLITE_BACKUP_DIR=data/backups_2

# --- Notifier (same bot allowed; prefer a distinct chat if you want split alerts) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_COMMANDS_ENABLED=true
DISCORD_WEBHOOK_URL=

# --- Locked risk / strategy (same as Instance #1) ---
MAX_NOTIONAL_PER_TRADE_USD=50
MAX_TOTAL_EXPOSURE_USD=200
POST_ONLY=true
STRATEGY_MODE=volume_sweet_spot
L2_IMBALANCE_ENABLED=true
REGIME_FILTER_ENABLED=true
MTF_ALIGN_ENABLED=true
ATR_SIZING_ENABLED=true
PERP_LEADLAG_ENABLED=true
PERP_LEADLAG_VENUES=binance,bybit
LOG_LEVEL=INFO
