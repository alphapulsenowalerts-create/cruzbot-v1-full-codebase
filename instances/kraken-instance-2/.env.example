# Apex Signals Now — Instance #2 (Kraken) scrubbed template
# Copy to .env and fill PLACEHOLDERS only. Never commit real secrets.
# Tier-1 Winning Formula lock (2026-09-20 CT) — see MASTER_SYSTEM_ARCHIVE.md §0.

# --- Mode (paper by default) ---
PAPER_TRADING_MODE=true
# Live requires: PAPER_TRADING_MODE=false AND python main.py --live
# then Telegram /mode live + /confirm_live
DRY_RUN=false
BROKER=kraken
ACCOUNT_EQUITY=1600
SYMBOLS=BTC-USD,ETH-USD,SOL-USD,XRP-USD,LINK-USD,AVAX-USD,SUI-USD,ADA-USD,DOGE-USD,DOT-USD,ATOM-USD,LTC-USD,UNI-USD,NEAR-USD
UNIVERSE_STOCKS=false
SYMBOL_MODE=ALLOWLIST
ALLOW_PAPER_SHORTS=false

# --- Kraken (PLACEHOLDERS ONLY) ---
KRAKEN_API_KEY=YOUR_KRAKEN_API_KEY
KRAKEN_API_SECRET=YOUR_KRAKEN_API_SECRET
KRAKEN_BASE_URL=https://api.kraken.com
KRAKEN_WS_URL=wss://ws.kraken.com/v2

# --- Unused brokers (leave empty) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_BASE_URL=https://api.coinbase.com

# --- Isolated Instance #2 paths ---
SQLITE_PATH=data/trading_bot_2.db
PAPER_BOOK_PATH=data/paper_book_2.json
ACTIVE_PARAMS_PATH=data/active_params_2.json
SQLITE_BACKUP_DIR=data/backups_2
TRADES_DB_PATH=data/trades.db
SQLITE_BACKUP_KEEP=7

# --- Tier-1 fees / Winning Formula ---
# 0.80% taker / 0.40% maker (RT 1.20%); HWM peak +1.20% → SL floor +1.25%
TAKER_FEE_RATE=0.008
MAKER_FEE_RATE=0.004
WINNING_FORMULA=true
ENTRY_THRESHOLD=60
TRADE_PROFILE=medium
STOP_LOSS_PROFILE=medium
TRAIL_FEE_BUFFER_PCT=0.0125
ELITE_FEE_LOCK_ARM_PCT=0.012
TP1_FRACTION=0
CIRCUIT_BREAKER_ENABLED=true
MIN_TP_PCT=0.0305

# --- Risk caps ---
MAX_RISK_PER_TRADE_PCT=0.015
MAX_RISK_PER_TRADE_PCT_CEILING=0.02
DAILY_DRAWDOWN_LIMIT_PCT=0.03
MAX_POSITION_PCT=0.25
MAX_NOTIONAL_PER_TRADE_USD=500
MAX_TOTAL_EXPOSURE_USD=3000
MAX_CONCURRENT_POSITIONS=3
MAX_HOLD_MINUTES=30
ALLOW_PYRAMIDING=false
QTY_PRECISION=8
QUIET_NOTIFIER=true
SLIPPAGE_BPS=5
SELL_REJECT_COOLDOWN_SECONDS=60

# --- Agent / feed ---
BAR_TIMEFRAME=1Min
LOOKBACK_BARS=100
AGENT_POLL_SECONDS=12
STALE_DATA_SECONDS=120
HTF_TIMEFRAME=1Hour
HTF_LOOKBACK_BARS=250
ENTRY_TIMEFRAME_5M=5Min
STALE_TICK_SECONDS=15

# --- LLM / Grok (optional) ---
USE_LLM=false
# XAI_API_KEY=YOUR_XAI_API_KEY
PREFILTER_VWAP_BOUNDARY_PCT=0.002
PREFILTER_VOLUME_SPIKE_MULT=2.75

# --- Entry quality ---
FEE_CLEAR_MULT=2.0
MIN_CONFIDENCE=62
RSI_BUY_CAP=72
POST_STOP_COOLDOWN_MIN=15

# --- Macro pause ---
MACRO_PAUSE_ENABLED=true
MACRO_PAUSE_MINUTES=15
MACRO_CALENDAR_URL=
MACRO_CALENDAR_API_KEY=

# --- Anti-revenge + trade memory ---
REVENGE_LOCKOUT_MINUTES=30
REVENGE_STOP_COUNT=2
TRADE_MEMORY_SIZE=5

# --- Notifier (PLACEHOLDERS) ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
TELEGRAM_COMMANDS_ENABLED=true

# --- Daily digest (7:00 AM America/Chicago) ---
SUMMARY_HOUR=7
SUMMARY_MINUTE=0
SUMMARY_TIMEZONE=America/Chicago
DAILY_DIGEST_ENABLED=true

# --- Kill switch ---
LIQUIDATE_ON_KILL=false

# --- Persistence / logging ---
POSTGRES_DSN=
LOG_LEVEL=INFO

# --- Volume Sweet Spot ---
STRATEGY_MODE=volume_sweet_spot
RVOL_BREAKOUT_MULT=2.0
PULLBACK_VOL_FRAC=0.5
MIN_CLEAR_TO_RESISTANCE_PCT=0.02
SWING_SL_BUFFER_PCT=0.002
POST_ONLY=true
TP1_RR=1.0
TP2_RR=2.5
RVOL_EXHAUSTION_MULT=3.0
VOLUME_SMA_PERIOD=20

# --- Structural guardrails ---
BUY_DEDUPE_SECONDS=300
MAX_SPREAD_PCT=0.0025
FEE_TO_TARGET_MULT=2.5
TOD_GATE_ENABLED=true
DISABLE_TOD_GATE=false

# --- Intelligence ---
L2_IMBALANCE_ENABLED=true
L2_IMBALANCE_BAND_PCT=0.005
L2_IMBALANCE_MIN_RATIO=1.2
REGIME_FILTER_ENABLED=true
REGIME_GATE_ENABLED=true
ADX_PERIOD=14
ADX_MIN=25
CHOP_PERIOD=14
CHOP_MAX=60
MTF_ALIGN_ENABLED=true
HTF_EMA_PERIOD=200
HTF_4H_TIMEFRAME=4Hour
HTF_CACHE_SECONDS=300
ATR_SIZING_ENABLED=true
ATR_SIZING_PERIOD=14
ATR_REF_PCT=0.01
BTC_REGIME_ENABLED=true
ELITE_RISK_ENABLED=true

# --- Intel V2: Lead-lag / Funding+OI / Optimizer / Failure blacklist ---
PERP_LEADLAG_ENABLED=true
PERP_SWEEP_MULT=3.0
PERP_SWEEP_WINDOW_SEC=5
PERP_LEADLAG_VENUES=binance,bybit
PERP_LIQ_WINDOW_SEC=10
PERP_LIQ_MIN_CLUSTER=5
PERP_SIGNAL_TTL_SEC=30
CVD_GATE_ENABLED=true
CVD_PERIOD_SEC=300
LIQ_SWEEP_GATE_ENABLED=true
LIQ_SWEEP_WINDOW_SEC=60
LIQ_SWEEP_NOTIONAL_USD=50000
LIQ_SWEEP_TTL_SEC=30
PHASE1_FAIL_CLOSED=true
PHASE1_ALLOW_COLD_FEED=false
FUNDING_OI_ENABLED=true
FUNDING_OI_POLL_SECONDS=60
FUNDING_BLOCK_THRESHOLD=0.0003
FUNDING_BOOST_THRESHOLD=-0.0001
FUNDING_OI_SURGE_PCT=0.02
FUNDING_STAGNANT_BARS=3
OPTIMIZER_ENABLED=true
OPTIMIZER_LOOKBACK_DAYS=14
FAILURE_BLACKLIST_ENABLED=true
FAILURE_LOOKBACK_HOURS=72
FAILURE_BLOCK_MINUTES=45

# --- Intel V3 ---
ONCHAIN_GUARDS_ENABLED=true
ONCHAIN_POLL_SECONDS=120
ONCHAIN_CACHE_TTL_SEC=180
ONCHAIN_INFLOW_SPIKE_MULT=2.5
STABLECOIN_MINT_BOOST=3.0
ONCHAIN_FLOW_URL=
ONCHAIN_STABLE_URL=
ONCHAIN_API_KEY=
ONCHAIN_MOCK_MODE=true
ORDER_RESLICE_ENABLED=true
ORDER_RESLICE_STALL_SEC=10
ORDER_RESLICE_MAX_TIMES=3
COINTEGRATION_ENABLED=true
COINT_Z_ENTRY=2.0
COINT_PAIRS=SOL-USD/AVAX-USD,ETH-USD/LINK-USD,BTC-USD/ETH-USD
COINT_WINDOW=96
COINT_MIN_CORR=0.5
SWEEP_FADE_ENABLED=true
SWEEP_FADE_LOOKBACK=50
SWEEP_FADE_ABSORPTION_RATIO=1.5

# --- Stabilization / local-tree ---
MAINTENANCE_INTERVAL_HOURS=6
ATR_BRACKET_EXITS=true
ATR_BRACKET_SL_MULT=1.8
ATR_BRACKET_TP_MULT=3.0
SL_MIN_PCT=0.012
ADX_THRESHOLD_FLOOR=20
ADX_THRESHOLD_RAISE=15
L2_PROXIMITY_BOOST_RATIO=1.5
L2_PROXIMITY_BOOST_PTS=10
SCAN_CONCURRENCY=6
BAR_BUFFER_MAXLEN=200
HTF_EMA200_LONG_FILTER=true
STOP_LOSS_ATR_MULT=1.0
TAKE_PROFIT_ATR_MULT=1.5
TRAILING_STOP_ATR_MULT=1.5
