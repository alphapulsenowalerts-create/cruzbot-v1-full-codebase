# --- Mode (paper by default) ---
PAPER_TRADING_MODE=true
# Live requires explicit opt-in: PAPER_TRADING_MODE=false AND python main.py --live
DRY_RUN=false
# alpaca | coinbase | mock | ib
# Al locked production: VWAP crypto scalps on Coinbase (8-coin hard allowlist)
BROKER=coinbase
ACCOUNT_EQUITY=200
# Crypto (Coinbase): BTC-USD,ETH-USD,SOL-USD  |  Stocks (Alpaca): AAPL,MSFT,SPY
SYMBOLS=BTC-USD,ETH-USD,SOL-USD,XRP-USD,LINK-USD,AVAX-USD,SUI-USD,ADA-USD
# Hard allowlist only — any other symbol is rejected even if set here/CLI

# --- Alpaca paper keys (never commit real secrets) ---
ALPACA_API_KEY=your_paper_key_id
ALPACA_SECRET_KEY=your_paper_secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_WS_URL=wss://stream.data.alpaca.markets/v2/iex

# --- Coinbase Advanced Trade (CDP API key) ---
# COINBASE_API_KEY = CDP key name, e.g. organizations/{org}/apiKeys/{id}
# COINBASE_API_SECRET = private key PEM (use \n for newlines in .env)
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_BASE_URL=https://api.coinbase.com

# --- Risk defaults (scalp-friendlier ATR / position; keep 1.5%/2% + 3% DD) ---
MAX_RISK_PER_TRADE_PCT=0.015
MAX_RISK_PER_TRADE_PCT_CEILING=0.02
DAILY_DRAWDOWN_LIMIT_PCT=0.03
MAX_POSITION_PCT=0.25
MAX_NOTIONAL_PER_TRADE_USD=50
MAX_TOTAL_EXPOSURE_USD=200
QTY_PRECISION=8
QUIET_NOTIFIER=true
STOP_LOSS_ATR_MULT=1.0
TAKE_PROFIT_ATR_MULT=1.5
TRAILING_STOP_ATR_MULT=1.5
# Hard time-stop: force exit if open longer than this (ATR exits still primary)
MAX_HOLD_MINUTES=30
# Reject new BUY if already long that symbol (default OFF = no pyramid)
ALLOW_PYRAMIDING=false
PAPER_BOOK_PATH=data/paper_book.json
SELL_REJECT_COOLDOWN_SECONDS=60
SLIPPAGE_BPS=5

# --- Agent / feed (1m bars, faster poll for scalps) ---
BAR_TIMEFRAME=1Min
LOOKBACK_BARS=100
AGENT_POLL_SECONDS=3
STALE_DATA_SECONDS=120
HTF_TIMEFRAME=1Hour
HTF_LOOKBACK_BARS=250
ENTRY_TIMEFRAME_5M=5Min

# --- Hybrid LLM pre-filter (LLM only when setup fires; default off) ---
USE_LLM=false
PREFILTER_VWAP_BOUNDARY_PCT=0.002
PREFILTER_VOLUME_SPIKE_MULT=2.75

# --- Entry quality gates (fee-aware BUY filters) ---
# Require TP distance (% of price) >= 2 * TAKER_FEE_RATE * FEE_CLEAR_MULT
# With Intro ~0.9% taker each way and FEE_CLEAR_MULT=2.0 → need ~3.6% TP move
# Tiny ATR → SKIP (do not widen SL/TP multiples)
FEE_CLEAR_MULT=2.0
# Min score confidence for BUY path
MIN_CONFIDENCE=62
# Block BUY chase when RSI above this
RSI_BUY_CAP=72
# After stop/trail exit, block new BUY on that symbol (minutes)
POST_STOP_COOLDOWN_MIN=20
# Cap open positions on the $200 paper book
MAX_CONCURRENT_POSITIONS=2

# --- Macro event pause (NFP/CPI/FOMC etc.) ---
MACRO_PAUSE_ENABLED=true
MACRO_PAUSE_MINUTES=15
MACRO_CALENDAR_URL=
MACRO_CALENDAR_API_KEY=

# --- Anti-revenge + trade memory ---
REVENGE_LOCKOUT_MINUTES=30
REVENGE_STOP_COUNT=2
TRADE_MEMORY_SIZE=5

# --- Notifier (empty = no-op) ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_COMMANDS_ENABLED=true
STALE_TICK_SECONDS=15

# --- Kill switch ---
LIQUIDATE_ON_KILL=false

# --- Persistence ---
SQLITE_PATH=data/trading_bot.db
POSTGRES_DSN=
LOG_LEVEL=INFO
TAKER_FEE_RATE=0.009
MAKER_FEE_RATE=0.005

# --- Volume Sweet Spot (Option B) ---
STRATEGY_MODE=volume_sweet_spot
RVOL_BREAKOUT_MULT=2.0
PULLBACK_VOL_FRAC=0.5
MIN_TP_PCT=0.025
MIN_CLEAR_TO_RESISTANCE_PCT=0.02
SWING_SL_BUFFER_PCT=0.002
POST_ONLY=true
TP1_RR=1.0
TP2_RR=2.5
TP1_FRACTION=0.5
RVOL_EXHAUSTION_MULT=3.0
VOLUME_SMA_PERIOD=20
# ATR exit mults disabled when STRATEGY_MODE=volume_sweet_spot

# --- Structural guardrails (hard rejects) ---
# 1) Dedup lock: max 1 position/coin (ALLOW_PYRAMIDING=false) + no duplicate BUY within N seconds
BUY_DEDUPE_SECONDS=300
# 2) Maker limit only: POST_ONLY=true (market orders rejected with market_orders_disabled)
# 3) Spread filter: skip BUY if (ask-bid)/mid > this fraction (0.001 = 0.1%)
MAX_SPREAD_PCT=0.001
# 4) Fee-to-target: require TP >= max(MIN_TP_PCT, FEE_TO_TARGET_MULT * 2 * MAKER_FEE_RATE)
#    With maker 0.5% → RT 1.0%; ×2.5 → 2.5% (aligned with MIN_TP_PCT=0.025)
FEE_TO_TARGET_MULT=2.5

# --- Intelligence upgrades ---
# 1) L2 order book depth imbalance filter
L2_IMBALANCE_ENABLED=true
L2_IMBALANCE_BAND_PCT=0.005
L2_IMBALANCE_MIN_RATIO=1.2
# 2) Market regime (ADX & Choppiness) — block BUY when ADX < 25 OR chop > 60
REGIME_FILTER_ENABLED=true
ADX_PERIOD=14
ADX_MIN=25
CHOP_PERIOD=14
CHOP_MAX=60
# 3) Multi-timeframe: price must be strictly above 1h and 4h EMA200
MTF_ALIGN_ENABLED=true
HTF_EMA_PERIOD=200
HTF_4H_TIMEFRAME=4Hour
HTF_CACHE_SECONDS=300
# 4) Dynamic ATR sizing: notional = base * (price * ATR_REF_PCT / ATR)
#    clipped to [MIN_NOTIONAL_USD, MAX_NOTIONAL_PER_TRADE_USD]; $50/$200 hard caps remain
ATR_SIZING_ENABLED=true
ATR_SIZING_PERIOD=14
ATR_REF_PCT=0.01

# --- Intel V2: Lead-lag / Funding+OI / Optimizer / Failure blacklist ---
PERP_LEADLAG_ENABLED=true
PERP_SWEEP_MULT=3.0
PERP_SWEEP_WINDOW_SEC=5
PERP_LEADLAG_VENUES=binance,bybit
PERP_LIQ_WINDOW_SEC=10
PERP_LIQ_MIN_CLUSTER=5
PERP_SIGNAL_TTL_SEC=30
FUNDING_OI_ENABLED=true
FUNDING_OI_POLL_SECONDS=60
FUNDING_BLOCK_THRESHOLD=0.0003
FUNDING_BOOST_THRESHOLD=-0.0001
FUNDING_OI_SURGE_PCT=0.02
FUNDING_STAGNANT_BARS=3
OPTIMIZER_ENABLED=true
OPTIMIZER_LOOKBACK_DAYS=14
ACTIVE_PARAMS_PATH=data/active_params.json
FAILURE_BLACKLIST_ENABLED=true
FAILURE_LOOKBACK_HOURS=72
FAILURE_BLOCK_MINUTES=45

# --- Intel V3: On-chain / Reslice / Cointegration / Sweep-fade ---
ONCHAIN_GUARDS_ENABLED=true
ONCHAIN_POLL_SECONDS=120
ONCHAIN_CACHE_TTL_SEC=180
ONCHAIN_INFLOW_SPIKE_MULT=2.5
STABLECOIN_MINT_BOOST=3.0
ONCHAIN_FLOW_URL=
ONCHAIN_STABLE_URL=
ONCHAIN_API_KEY=
ONCHAIN_MOCK_MODE=true
ORDER_RESLICE_ENABLED=true
ORDER_RESLICE_STALL_SEC=10
ORDER_RESLICE_MAX_TIMES=3
COINTEGRATION_ENABLED=true
COINT_Z_ENTRY=2.0
COINT_PAIRS=SOL-USD/AVAX-USD,ETH-USD/LINK-USD,BTC-USD/ETH-USD
COINT_WINDOW=96
COINT_MIN_CORR=0.5
SWEEP_FADE_ENABLED=true
SWEEP_FADE_LOOKBACK=50
SWEEP_FADE_ABSORPTION_RATIO=1.5

# --- Stabilization (code freeze) ---
MAINTENANCE_INTERVAL_HOURS=6
SQLITE_BACKUP_KEEP=7
SQLITE_BACKUP_DIR=data/backups
